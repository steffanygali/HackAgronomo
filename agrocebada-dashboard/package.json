{
  "name": "agrocebada-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Dashboard del modelo de predicción de rendimiento de cebada — Reto AgroCebada FIRA 2026",
  "scripts": {
    "seed": "node scripts/build-seed.mjs",
    "prebuild": "npm run seed",
    "build": "tsc -b && vite build",
    "pretest": "npm run seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite",
    "preview": "vite preview",
    "mock-api": "node scripts/mock-api.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "typescript": "5.6.2",
    "typescript-eslint": "8.18.1",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
