# mock (por defecto): la app lee los JSON generados en public/data (sin red).
# api: la app llama a VITE_API_BASE_URL siguiendo docs/openapi.yaml.
VITE_DATA_MODE=mock

# Solo se usa cuando VITE_DATA_MODE=api. Debe apuntar a la raíz del backend
# (el prefijo /api/v1 se agrega automáticamente).
VITE_API_BASE_URL=http://localhost:8080
